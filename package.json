{
  "name": "@dazzadev/vue-sheet-mapper",
  "version": "3.1.0",
  "description": "Vue 3 component for Excel and CSV imports: users match each column of their file to one of your fields",
  "author": "Andres Daza (https://github.com/dazza-dev)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dazza-dev/vue-sheet-mapper.git"
  },
  "homepage": "https://dazza-dev.github.io/vue-sheet-mapper/",
  "bugs": {
    "url": "https://github.com/dazza-dev/vue-sheet-mapper/issues"
  },
  "type": "module",
  "main": "./dist/vue-sheet-mapper.cjs",
  "module": "./dist/vue-sheet-mapper.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/vue-sheet-mapper.js",
      "require": "./dist/vue-sheet-mapper.cjs",
      "types": "./dist/src/index.d.ts"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:demo": "vite build --config vite.demo.config.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "vue": ">=3.3.0",
    "xlsx": ">=0.18.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/compiler-sfc": "^3.5.38",
    "@vue/language-core": "^3.3.5",
    "@vue/test-utils": "^2.4.11",
    "axe-core": "^4.13.0",
    "happy-dom": "^20.10.3",
    "highlight.js": "^11.12.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^5.0.2",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.8",
    "vue": "^3.5.38",
    "vue-tsc": "^3.3.5",
    "xlsx": "^0.18.5"
  },
  "keywords": [
    "vue",
    "vue3",
    "excel",
    "csv",
    "xlsx",
    "import",
    "column-mapper"
  ],
  "packageManager": "pnpm@10.33.3"
}
