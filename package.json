{
  "name": "@dazzadev/vue-sheet-mapper",
  "version": "1.1.0",
  "description": "Vue 3 component for mapping Excel/CSV columns to a schema",
  "type": "module",
  "main": "./dist/vue-sheet-mapper.cjs",
  "module": "./dist/vue-sheet-mapper.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/vue-sheet-mapper.js",
      "require": "./dist/vue-sheet-mapper.cjs",
      "types": "./dist/src/index.d.ts"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:demo": "vite build --config vite.demo.config.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "vue": ">=3.3.0",
    "xlsx": "^0.18.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/compiler-sfc": "^3.5.38",
    "@vue/language-core": "^3.3.5",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.10.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^5.0.2",
    "vitest": "^4.1.8",
    "vue": "^3.5.38",
    "vue-tsc": "^3.3.5",
    "xlsx": "^0.18.5"
  },
  "keywords": [
    "vue",
    "vue3",
    "excel",
    "csv",
    "xlsx",
    "import",
    "column-mapper"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.33.3"
}
